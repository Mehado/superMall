<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.supermall.mall.mapper.MallAdminMapper">

    <select id="getByUsername" resultType="com.supermall.mall.entity.MallAdmin">
        select * from mall_admin where username = #{username}
    </select>

    <select id="getById" resultType="com.supermall.mall.entity.MallAdmin">
        select * from mall_admin where id = #{id}
    </select>
</mapper>
