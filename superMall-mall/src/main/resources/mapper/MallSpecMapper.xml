<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.supermall.mall.mapper.MallSpecMapper">

    <select id="listByProductId" resultType="com.supermall.mall.entity.MallSpec">
        select id, product_id, name, sort, create_time
        from mall_spec
        where product_id = #{productId}
        order by sort asc, id asc
    </select>

    <!-- 单条插入：MySQL 多行 INSERT 时 JDBC 只可靠返回第一个自增 id，
         而建规格值要用到 spec.id，所以逐条插 -->
    <insert id="insert" parameterType="com.supermall.mall.entity.MallSpec"
            useGeneratedKeys="true" keyProperty="id">
        insert into mall_spec (product_id, name, sort, create_time)
        values (#{productId}, #{name}, #{sort}, #{createTime})
    </insert>

    <delete id="deleteByProductId">
        delete from mall_spec where product_id = #{productId}
    </delete>
</mapper>
