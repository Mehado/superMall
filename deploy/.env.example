# 复制成仓库根目录的 .env 后按需修改：cp deploy/.env.example .env
#
# ⚠️ JASYPT_ENCRYPTOR_PASSWORD 必填：两个后端所有 ENC(...) 配置都靠它解密。
JASYPT_ENCRYPTOR_PASSWORD=change-me

# 数据库 / Redis 密码：必须与 yml 里 ENC(...) 的解密值一致（默认如下）。
# 改了这里就要用 `mvn -N jasypt:encrypt-value -Djasypt.plugin.value="新密码"` 重新加密并替换 yml。
MYSQL_ROOT_PASSWORD=Ming1234
REDIS_PASSWORD=mehado

# ---------- 宿主端口（默认不写就用下面的默认值）----------
# 本机如果已经装了 MySQL / Redis / RabbitMQ，默认端口会冲突 → 改这里的**宿主侧**端口即可，
# 容器之间仍然走服务名 + 容器内端口，互不影响。
# MYSQL_HOST_PORT=13306
# REDIS_HOST_PORT=16379
# RABBITMQ_HOST_PORT=15673
# RABBITMQ_CONSOLE_PORT=15674
# TAKEOUT_HOST_PORT=18080
# MALL_HOST_PORT=18081
# NGINX_HOST_PORT=8088

# ---------- 演示图（在 OSS，不在仓库里）----------
# DB 里存的是 https://<bucket>.<endpoint>/supermall/seed/xxx.jpg 这种绝对地址，
# 所以容器要能出网访问 OSS；不然页面商品/分类图会是灰占位（功能不受影响）。
# 换 bucket：改 application.yml 的 bucket-name → node scripts/migrate-seed-images-to-oss.mjs --apply
