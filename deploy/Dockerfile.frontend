# ============================================================
# superMall 前端镜像（六端合一前端 + Nginx）
# ------------------------------------------------------------
# 多阶段：Node 构建 → Nginx 托管。
# 这样"从零 clone + 只有 Docker"也能一条命令起全套 —— **宿主机不需要装 Node**。
#
# 构建：docker build -f deploy/Dockerfile.frontend -t supermall-frontend .
# 产物：Nginx 静态根 /usr/share/nginx/html（= 前端 dist），并用 deploy/nginx.conf 做 /api 反代
# ============================================================

# ---------- 构建阶段 ----------
FROM node:22-alpine AS build
WORKDIR /build

# 先拷清单装依赖（换源码不会重新装依赖）。
# 注意：仓库里没有 package-lock.json，所以用 npm install；若以后补上 lock 文件，可改成 `npm ci`。
COPY frontend/package.json ./
RUN npm install --no-audit --no-fund

# 再拷源码构建（dist 会被 vite 输出到 /build/dist）
COPY frontend/ ./
RUN npm run build

# ---------- 运行阶段 ----------
FROM nginx:1.27-alpine
# 反代配置（/api/mall → mall:8081，/api → takeout:8080）
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist /usr/share/nginx/html
EXPOSE 80
